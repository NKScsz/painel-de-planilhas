rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário só lê e grava as próprias bases:
    // data/users/{uid}/app/bases/{baseId}/chunks/{chunkId}
    match /data/users/{uid}/{rest=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Links de compartilhamento (somente leitura para quem tem o link):
    // shares/{token} guarda uma cópia do painel; só o dono cria, altera ou apaga.
    // Não é possível listar os links: só abre quem sabe o token.
    match /shares/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.owner == request.auth.uid;
      allow update: if request.auth != null && resource.data.owner == request.auth.uid
                    && request.resource.data.owner == request.auth.uid;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
      match /chunks/{chunkId} {
        allow read: if true;
        allow write: if request.auth != null
                     && get(/databases/$(database)/documents/shares/$(token)).data.owner == request.auth.uid;
      }
    }
    // Todo o resto fica bloqueado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

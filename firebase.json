{
  "hosting": {
    "public": "dist",
    "predeploy": ["npm run check"],
    "ignore": ["**/.*", "**/*.map"],
    "redirects": [
      { "source": "/Painel de Planilhas.html", "destination": "/", "type": 301 },
      { "source": "/Painel%20de%20Planilhas.html", "destination": "/", "type": 301 }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/index.html",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      },
      {
        "source": "/robots.txt",
        "headers": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }]
      },
      {
        "source": "/404.html",
        "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
      },
      {
        "source": "/sw.js",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }, { "key": "Content-Type", "value": "text/javascript; charset=utf-8" }]
      },
      {
        "source": "/manifest.webmanifest",
        "headers": [{ "key": "Content-Type", "value": "application/manifest+json; charset=utf-8" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
